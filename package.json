{
  "name": "mini-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --workspace mini-crm-api run dev",
    "build": "node scripts/generate-prisma-for-vercel.mjs && vite build",
    "build:api": "npm --workspace mini-crm-api run build",
    "build:all": "npm run build && npm run build:api",
    "db:dev": "npm --workspace mini-crm-api run db:dev",
    "db:migrate": "npm --workspace mini-crm-api run db:migrate",
    "db:seed": "npm --workspace mini-crm-api run db:seed",
    "start": "vite preview",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm --workspace mini-crm-api test",
    "typecheck": "tsc --noEmit && npm --workspace mini-crm-api run typecheck",
    "lint": "eslint src api tests vite.config.ts --ignore-pattern dist && npm --workspace mini-crm-api run lint"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "es-abstract": "^1.23.9",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
